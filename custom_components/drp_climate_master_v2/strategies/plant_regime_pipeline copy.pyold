"""Plant-aware HVAC regime inference + threshold fitting.

This module implements a clean, class-based pipeline that:
  1) Reads time series from InfluxDB v2 (Home Assistant Influx integration).
  2) Normalizes signals (numbers, binary sensors, switches).
  3) Builds a *plant-aware* observed regime label per day:
       - heating_radiant
       - cooling_radiant
       - dehumid_vmc
       - shoulder
       - None (ambiguous / low-duty)
  4) Fits a simple outdoor-temperature regime model with hysteresis + smoothing
     via grid search and returns the best RegimeConfig.

Key design decisions (based on your dataset):
- Always filter Influx `_field == "value"` for numeric entities (numbers/sensors).
  HA writes many meta-fields (min/max/step/precision/description_str/...) that can
  confuse naive queries.
- Avoid `query_api.query_data_frame()` to stay compatible with pandas 2+.

NOTE
----
- Entity IDs: pass the *tag value* as stored in Influx (your data shows entity_id like
  "ambient_outdoor_temperature" without the HA prefix "sensor.").
- Switch state in Influx is typically stored in `_value` as "on"/"off" (strings).
- Your PDC device mode uses values: 1=Heat, 5=Cool.

You can import and use PlantRegimePipeline from your scripts; keep `main()` outside.
"""
from __future__ import annotations

from dataclasses import dataclass
from typing import Any, Dict, Iterable, List, Optional, Sequence, Tuple, cast

import math
import os

import pandas as pd
from pandas import DatetimeIndex
from influxdb_client import InfluxDBClient

# from ..domain.influx import InfluxConfig


# ----------------------------- dataclasses -----------------------------
@dataclass(frozen=True, slots=True)
class InfluxConfig:
    url: str
    org: str
    token: str
    bucket: str

@dataclass(frozen=True, slots=True)
class PlantEntities:
    """Entity id mapping (Influx `entity_id` tag values)."""

    outdoor_temp: str
    compressor_state: str
    device_mode: str
    vmc_pump_switch: str
    radiant_pump_switch: str
    active_power: str


@dataclass(frozen=True, slots=True)
class RegimeConfig:
    tau_days: float
    heating_on: float
    heating_off: float
    cooling_on: float
    cooling_off: float


@dataclass(frozen=True, slots=True)
class CandidateScore:
    cfg: RegimeConfig
    loss: float
    err: float
    pen: float
    switches: int
    days: int


@dataclass(frozen=True, slots=True)
class RegimeSearchResult:
    best: CandidateScore
    top10: List[CandidateScore]
    obs_counts: pd.Series
    common_days: int


# ----------------------------- Influx reader -----------------------------


class InfluxSeriesReader:
    """InfluxDB v2 reader specialized for HA Influx schema."""

    def __init__(self, cfg: InfluxConfig):
        self._cfg = cfg
        self._client = InfluxDBClient(url=cfg.url, token=cfg.token, org=cfg.org)
        self._query_api = self._client.query_api()

    def close(self) -> None:
        try:
            self._client.close()
        except Exception:
            pass

    @staticmethod
    def _flux_to_dataframe(query_api, flux: str) -> pd.DataFrame:
        """Run a Flux query and return a DataFrame (robust).

        We avoid query_api.query_data_frame() because some versions rely on
        DataFrame.append() (removed in pandas 2+).

        We also avoid record.get_measurement() which may raise KeyError in some
        responses.
        """
        tables = query_api.query(flux)
        rows: List[Dict[str, Any]] = []

        for table in tables:
            for record in table.records:
                vals = record.values or {}

                # time/value are generally safe, but keep fallbacks
                try:
                    t = record.get_time()
                except Exception:
                    t = vals.get("_time")

                try:
                    v = record.get_value()
                except Exception:
                    v = vals.get("_value")

                rows.append(
                    {
                        "_time": t,
                        "_field": vals.get("_field"),
                        "_value": v,
                        "entity_id": vals.get("entity_id"),
                        "_measurement": vals.get("_measurement"),
                    }
                )

        if not rows:
            return pd.DataFrame()

        df = pd.DataFrame(rows)
        df["_time"] = pd.to_datetime(df["_time"], utc=True, errors="coerce")
        df = df.dropna(subset=["_time"]).sort_values("_time")
        return df

    def fetch_entity_df(
        self,
        entity_id: str,
        start: str,
        stop: str,
        *,
        every: str = "5m",
        field: Optional[str] = "value",
        agg_fn: str = "last",
    ) -> pd.DataFrame:
        """Fetch an entity series as a DataFrame indexed by _time.

        Parameters
        ----------
        entity_id:
            Influx tag `entity_id` value (e.g. "ambient_outdoor_temperature").
        start/stop:
            Flux range arguments, e.g. "-730d" / "now()".
        every:
            Flux aggregateWindow interval.
        field:
            Filter `_field == field` (recommended). For HA numbers/sensors, use "value".
            For some switches you may also use "value" (depending on your Influx config).
        agg_fn:
            "last" is safest with mixed types. For numeric sensors you can also use "mean".
        """
        if agg_fn not in {"last", "mean", "min", "max"}:
            raise ValueError(f"Unsupported agg_fn={agg_fn}")

        field_filter = f'  |> filter(fn: (r) => r["_field"] == "{field}")\n' if field else ""

        flux = f"""
from(bucket: \"{self._cfg.bucket}\")
  |> range(start: {start}, stop: {stop})
  |> filter(fn: (r) => r[\"entity_id\"] == \"{entity_id}\")
{field_filter}  |> aggregateWindow(every: {every}, fn: {agg_fn}, createEmpty: false)
  |> keep(columns: [\"_time\",\"_field\",\"_value\",\"entity_id\",\"_measurement\"])
""".strip()

        df = self._flux_to_dataframe(self._query_api, flux)
        if df.empty:
            return pd.DataFrame(
                columns=["_field", "_value", "entity_id", "_measurement"],
                index=pd.DatetimeIndex([], tz="UTC"),
            )

        return df.set_index("_time").sort_index()

    @staticmethod
    def df_to_value_series(df: pd.DataFrame) -> pd.Series:
        if df is None or df.empty:
            return pd.Series(dtype=object)
        return df["_value"].copy()


# ----------------------------- utilities -----------------------------


def _as_bool_switch(series: pd.Series) -> pd.Series:
    """Convert HA switch state series to boolean."""
    if series is None or series.empty:
        return pd.Series(dtype=bool)

    # handle numeric 0/1
    num = pd.to_numeric(series, errors="coerce")
    if num.notna().any():
        return num.fillna(0).astype(int).astype(bool)

    s = series.astype(str).str.lower()
    return s.isin(["on", "true", "1", "yes"])


def _as_bool_binary(series: pd.Series) -> pd.Series:
    """Convert binary_sensor-like series (on/off, true/false, 0/1) to boolean."""
    return _as_bool_switch(series)


def _to_float(series: pd.Series) -> pd.Series:
    if series is None or series.empty:
        return pd.Series(dtype=float)
    return pd.to_numeric(series, errors="coerce")


def _ensure_utc_index(s: pd.Series) -> pd.Series:
    if s is None or s.empty:
        return s

    idx = s.index
    if not isinstance(idx, DatetimeIndex):
        # either raise, or try to coerce:
        raise TypeError(f"Expected DatetimeIndex, got {type(idx).__name__}")

    if idx.tz is None:
        s.index = idx.tz_localize("UTC")
    else:
        s.index = idx.tz_convert("UTC")
    return s


# ----------------------------- main pipeline -----------------------------


class PlantRegimePipeline:
    """End-to-end plant-aware regime pipeline."""

    def __init__(
        self,
        reader: InfluxSeriesReader,
        entities: PlantEntities,
        *,
        start: str = "-730d",
        stop: str = "now()",
        debug: bool = False,
        power_threshold_w: float = 250.0,
        duty_min: float = 0.20,
        shoulder_duty_max: float = 0.02,
        cool_vmc_duty_min: Optional[float] = None,
    ):
        self.reader = reader
        self.entities = entities

        self.start = start
        self.stop = stop

        self.debug = debug
        self.power_threshold_w = float(power_threshold_w)
        self.duty_min = float(duty_min)
        self.shoulder_duty_max = float(shoulder_duty_max)

        # If not provided, reuse duty_min.
        # In many plants, VMC dehumid runs shorter than radiant cooling; you might
        # later want e.g. cool_vmc_duty_min=0.05.
        self.cool_vmc_duty_min = float(cool_vmc_duty_min) if cool_vmc_duty_min is not None else float(duty_min)

    # --------------------- data acquisition ---------------------

    def load_raw(self) -> Dict[str, pd.Series]:
        """Fetch raw series from Influx."""
        out_df = self.reader.fetch_entity_df(
            self.entities.outdoor_temp,
            self.start,
            self.stop,
            every="30m",
            field="value",
            agg_fn="mean",
        )

        comp_df = self.reader.fetch_entity_df(
            self.entities.compressor_state,
            self.start,
            self.stop,
            every="5m",
            field="value",
            agg_fn="last",
        )

        mode_df = self.reader.fetch_entity_df(
            self.entities.device_mode,
            self.start,
            self.stop,
            every="5m",
            field="value",
            agg_fn="last",
        )

        vmc_df = self.reader.fetch_entity_df(
            self.entities.vmc_pump_switch,
            self.start,
            self.stop,
            every="5m",
            field="value",
            agg_fn="last",
        )

        rad_df = self.reader.fetch_entity_df(
            self.entities.radiant_pump_switch,
            self.start,
            self.stop,
            every="5m",
            field="value",
            agg_fn="last",
        )

        pwr_df = self.reader.fetch_entity_df(
            self.entities.active_power,
            self.start,
            self.stop,
            every="5m",
            field="value",
            agg_fn="mean",
        )

        raw = {
            "T_out": self.reader.df_to_value_series(out_df),
            "compressor": self.reader.df_to_value_series(comp_df),
            "device_mode": self.reader.df_to_value_series(mode_df),
            "vmc_pump": self.reader.df_to_value_series(vmc_df),
            "radiant_pump": self.reader.df_to_value_series(rad_df),
            "power": self.reader.df_to_value_series(pwr_df),
        }

        for k, s in raw.items():
            raw[k] = _ensure_utc_index(s)

        return raw

    def normalize(self, raw: Dict[str, pd.Series]) -> Dict[str, pd.Series]:
        """Normalize raw series into numeric/bool series."""
        T_out = _to_float(raw["T_out"])  # °C
        compressor_on = _as_bool_binary(raw["compressor"])
        device_mode = _to_float(raw["device_mode"])  # 1/5
        vmc_pump_on = _as_bool_switch(raw["vmc_pump"])
        radiant_pump_on = _as_bool_switch(raw["radiant_pump"])
        power_w = _to_float(raw["power"])

        if self.debug:
            dm = device_mode.dropna()
            print("\nDEBUG device_mode sanity (after fetch/convert):")
            print("  samples:", int(dm.shape[0]))
            if not dm.empty:
                print("  time span:", dm.index.min(), "->", dm.index.max())
                print("  unique values:", sorted(pd.unique(dm))[:20])
                print("  count value==1:", int((dm == 1).sum()), " value==5:", int((dm == 5).sum()))
                if int((dm == 5).sum()) > 0:
                    print("  first value==5:", dm[dm == 5].index.min(), " last value==5:", dm[dm == 5].index.max())

            print("\nDEBUG counts (non-NaN):")
            print("T_out:", int(T_out.dropna().shape[0]))
            print("compressor:", int(compressor_on.dropna().shape[0]))
            print("device_mode:", int(device_mode.dropna().shape[0]))
            print("vmc_pump:", int(vmc_pump_on.dropna().shape[0]))
            print("radiant_pump:", int(radiant_pump_on.dropna().shape[0]))
            print("power:", int(power_w.dropna().shape[0]))

        return {
            "T_out": T_out,
            "compressor_on": compressor_on,
            "device_mode": device_mode,
            "vmc_pump_on": vmc_pump_on,
            "radiant_pump_on": radiant_pump_on,
            "active_power_w": power_w,
        }

    # --------------------- observed regimes ---------------------

    def build_observed_daily_regime(self, norm: Dict[str, pd.Series]) -> Tuple[pd.Series, pd.DataFrame, pd.DataFrame]:
        """Build plant-aware observed regime labels per day.

        Returns
        -------
        obs_regime_daily: pd.Series
            Daily labels in {"heating_radiant","cooling_radiant","dehumid_vmc","shoulder",None}
        duty_daily: pd.DataFrame
            Daily duty fractions for key booleans.
        frame: pd.DataFrame
            Full aligned 5m-ish dataframe (for debugging).
        """
        compressor_on = norm["compressor_on"]
        device_mode = norm["device_mode"]
        vmc_pump_on = norm["vmc_pump_on"]
        radiant_pump_on = norm["radiant_pump_on"]
        pwr = norm["active_power_w"]

        # Build a common time index from the densest series (power) if available,
        # otherwise union of all indices.
        indices = [s.index for s in [compressor_on, device_mode, vmc_pump_on, radiant_pump_on, pwr] if s is not None and not s.empty]
        if not indices:
            return pd.Series(dtype=object), pd.DataFrame(), pd.DataFrame()

        idx = indices[0]
        for other in indices[1:]:
            idx = idx.union(other)
        idx = idx.sort_values()

        df = pd.DataFrame(index=idx)

        # ffill is important: mode/pumps may change sparsely
        df["compressor_on"] = compressor_on.reindex(idx).ffill().infer_objects(copy=False)
        df["device_mode"] = device_mode.reindex(idx).ffill()
        df["vmc_pump_on"] = vmc_pump_on.reindex(idx).ffill().infer_objects(copy=False)
        df["radiant_pump_on"] = radiant_pump_on.reindex(idx).ffill().infer_objects(copy=False)
        df["active_power_w"] = pwr.reindex(idx).ffill()  # may be sparse too

        # Robust numeric cast for device_mode and power
        df["device_mode"] = pd.to_numeric(df["device_mode"], errors="coerce")
        df["active_power_w"] = pd.to_numeric(df["active_power_w"], errors="coerce")

        mode_heat = df["device_mode"] == 1
        mode_cool = df["device_mode"] == 5

        pwr_ok = df["active_power_w"] >= self.power_threshold_w

        # Define "active" only when mode matches AND compressor is ON AND power is meaningfully high.
        cool_active = mode_cool & df["compressor_on"].astype(bool) & pwr_ok
        heat_active = mode_heat & df["compressor_on"].astype(bool) & pwr_ok

        # Plant routing
        cool_radiant = cool_active & df["radiant_pump_on"].astype(bool)
        cool_vmc = cool_active & df["vmc_pump_on"].astype(bool) & (~df["radiant_pump_on"].astype(bool))

        heat_radiant = heat_active & df["radiant_pump_on"].astype(bool)

        # Store booleans
        df["mode_heat"] = mode_heat
        df["mode_cool"] = mode_cool
        df["pwr_ok"] = pwr_ok
        df["cool_active"] = cool_active
        df["heat_active"] = heat_active
        df["cool_radiant"] = cool_radiant
        df["cool_vmc"] = cool_vmc
        df["heat_radiant"] = heat_radiant

        if self.debug:
            print("[DEBUG] build_observed_daily_regime:")
            print("  index span:", df.index.min(), "->", df.index.max(), "samples:", int(df.shape[0]))
            dm_u = sorted(pd.unique(pd.to_numeric(df["device_mode"].dropna(), errors="coerce").dropna()))
            print("  device_mode unique (after to_numeric, dropna):", dm_u)
            print("  mode_heat true samples:", int(mode_heat.sum()))
            print("  mode_cool true samples:", int(mode_cool.sum()))
            print("  compressor_on true samples:", int(df["compressor_on"].astype(bool).sum()))
            print("  pwr_ok true samples:", int(pwr_ok.sum()), "/", int(df.shape[0]))
            print("  cool_active true samples:", int(cool_active.sum()))
            n_mode5 = int(mode_cool.sum())
            n_mode5_comp = int((mode_cool & df["compressor_on"].astype(bool)).sum())
            n_mode5_comp_pwr = int((mode_cool & df["compressor_on"].astype(bool) & pwr_ok).sum())
            print("  mode=5 samples:", n_mode5)
            print("    - mode=5 & compressor_on:", n_mode5_comp)
            print("    - mode=5 & compressor_on & pwr_ok:", n_mode5_comp_pwr)
            if n_mode5 > 0:
                ex5 = df[df["mode_cool"]].head(5)
                print("  examples mode=5 rows (first 5):")
                for ts, r in ex5.iterrows():
                    print(
                        "   ",
                        ts,
                        "compressor_on=",
                        bool(r["compressor_on"]),
                        "pwr_ok=",
                        bool(r["pwr_ok"]),
                        "pwr=",
                        float(r["active_power_w"]) if not pd.isna(r["active_power_w"]) else None,
                        "radiant_pump=",
                        bool(r["radiant_pump_on"]),
                        "vmc_pump=",
                        bool(r["vmc_pump_on"]),
                    )
            print("    - cool_active & radiant_pump_on:", int(cool_radiant.sum()))
            print("    - cool_active & vmc_pump_on & ~radiant:", int(cool_vmc.sum()))

            print("  heat_active true samples:", int(heat_active.sum()))
            print("    - heat_active & radiant_pump_on:", int(heat_radiant.sum()))

            # cases where mode_cool but not active
            ex = df[df["mode_cool"] & (~df["cool_active"])].head(5)
            if not ex.empty:
                print("  examples mode_cool but NOT cool_active (first 5):")
                for ts, r in ex.iterrows():
                    print(
                        "   ",
                        ts,
                        "compressor_on=",
                        bool(r["compressor_on"]),
                        "pwr_ok=",
                        bool(r["pwr_ok"]),
                        "pwr=",
                        float(r["active_power_w"]) if not pd.isna(r["active_power_w"]) else None,
                        "radiant_pump=",
                        bool(r["radiant_pump_on"]),
                        "vmc_pump=",
                        bool(r["vmc_pump_on"]),
                    )

        # Daily duty fractions
        duty = pd.DataFrame(
            {
                "heat_radiant": df["heat_radiant"].astype(bool),
                "cool_radiant": df["cool_radiant"].astype(bool),
                "cool_vmc": df["cool_vmc"].astype(bool),
                "heat_active": df["heat_active"].astype(bool),
                "cool_active": df["cool_active"].astype(bool),
            },
            index=df.index,
        ).resample("1D").mean()

        if self.debug and not duty.empty:
            def _summ(name: str) -> str:
                s = duty[name].dropna()
                if s.empty:
                    return f"{name}: days=0"
                return (
                    f"{name}: days={len(s)} max={s.max():.3f} q50={s.quantile(0.50):.3f} "
                    f"q90={s.quantile(0.90):.3f} q95={s.quantile(0.95):.3f} q99={s.quantile(0.99):.3f}"
                )

            print("[DEBUG] daily duty (mean of booleans) summary:")
            for k in ["heat_radiant", "cool_radiant", "cool_vmc", "heat_active", "cool_active"]:
                print(" ", _summ(k))

        # Daily regime classification
        obs = pd.Series(index=duty.index, dtype=object)

        for day, hr, cr, cv, ha, ca in zip(
            duty.index,
            duty["heat_radiant"].fillna(0.0),
            duty["cool_radiant"].fillna(0.0),
            duty["cool_vmc"].fillna(0.0),
            duty["heat_active"].fillna(0.0),
            duty["cool_active"].fillna(0.0),
        ):
            if hr >= self.duty_min:
                obs.at[day] = "heating_radiant"
            elif cr >= self.duty_min:
                obs.at[day] = "cooling_radiant"
            elif cv >= self.cool_vmc_duty_min:
                obs.at[day] = "dehumid_vmc"
            else:
                obs.at[day] = "shoulder" if max(float(ha), float(ca)) <= self.shoulder_duty_max else None

        if self.debug and not duty.empty:
            mask = (duty["cool_active"].fillna(0) > 0) & (
                (duty["cool_radiant"].fillna(0) < self.duty_min)
                & (duty["cool_vmc"].fillna(0) < self.cool_vmc_duty_min)
            )
            ex_days = duty.loc[mask, ["cool_active", "cool_radiant", "cool_vmc", "heat_active", "heat_radiant"]].head(10)
            if not ex_days.empty:
                print("[DEBUG] days with some cool_active but not classified as cooling_radiant/dehumid_vmc (first 10):")
                print(ex_days)

        return obs, duty, df

    # --------------------- regime prediction model ---------------------

    @staticmethod
    def _smooth_outdoor(T_out_daily: pd.Series, tau_days: float) -> pd.Series:
        """EWMA smoothing with a tau-like parameter.

        We interpret tau_days as an EWMA span in days (approx). This gives a stable,
        low-frequency signal for regime decisions.
        """
        s = T_out_daily.copy()
        s = s.sort_index()
        # Ensure daily frequency index is treated as regular
        return s.ewm(span=max(1.0, float(tau_days)), adjust=False).mean()

    @staticmethod
    def _predict_regime_from_outdoor(T_s: pd.Series, cfg: RegimeConfig) -> pd.Series:
        state: str = "shoulder"
        vals: list[object] = []

        for _, t in T_s.items():
            if pd.isna(t):
                vals.append(None)
                continue

            tt = float(t)

            if state == "shoulder":
                if tt <= cfg.heating_on:
                    state = "heating"
                elif tt >= cfg.cooling_on:
                    state = "cooling"
            elif state == "heating":
                if tt >= cfg.heating_off:
                    state = "shoulder"
            elif state == "cooling":
                if tt <= cfg.cooling_off:
                    state = "shoulder"

            vals.append(state)

        return pd.Series(vals, index=T_s.index, dtype=object)


    @staticmethod
    def _map_observed_to_macro(obs: pd.Series) -> pd.Series:
        """Map plant-aware observed labels to macro regime classes."""
        # cooling_radiant and dehumid_vmc are both "cooling" macro regime.
        mapping = {
            "heating_radiant": "heating",
            "cooling_radiant": "cooling",
            "dehumid_vmc": "cooling",
            "shoulder": "shoulder",
        }
        return obs.map(mapping)

    @staticmethod
    def _count_switches(series: pd.Series) -> int:
        s = series.dropna()
        if s.empty:
            return 0
        prev = None
        switches = 0
        for v in s.values:
            if prev is None:
                prev = v
                continue
            if v != prev:
                switches += 1
                prev = v
        return switches

    @staticmethod
    def _accuracy(pred: pd.Series, obs: pd.Series) -> Tuple[float, int]:
        """Accuracy over common non-null days."""
        common = pred.index.intersection(obs.index)
        if common.empty:
            return float("nan"), 0

        p = pred.loc[common]
        o = obs.loc[common]

        mask = p.notna() & o.notna()
        if mask.sum() == 0:
            return float("nan"), 0

        correct = (p[mask] == o[mask]).sum()
        return float(correct / mask.sum()), int(mask.sum())

    # --------------------- grid search ---------------------

    def grid_search_regime(
        self,
        T_out_daily: pd.Series,
        obs_regime_daily: pd.Series,
        *,
        tau_grid: Sequence[float] = (3.0, 5.0, 7.0),
        heating_on_grid: Sequence[float] = tuple(x / 2 for x in range(24, 33)),  # 12.0..16.0 step 0.5
        heating_hyst: float = 1.0,
        cooling_on_grid: Sequence[float] = tuple(x / 2 for x in range(44, 53)),  # 22.0..26.0 step 0.5
        cooling_hyst: float = 1.0,
        switch_penalty_weight: float = 0.01,
        top_k: int = 10,
    ) -> RegimeSearchResult:
        """Fit outdoor-temperature regime thresholds to observed plant regimes."""

        obs_macro = self._map_observed_to_macro(obs_regime_daily)

        # Keep only days with an observed macro label (ignore None)
        obs_macro = obs_macro.dropna()

        # daily outdoor
        T_out_daily = _ensure_utc_index(_to_float(T_out_daily).dropna())

        # align to UTC daily index
        idx = cast(pd.DatetimeIndex, T_out_daily.index)

        if idx.tz is None:
            idx = idx.tz_localize("UTC")
        else:
            idx = idx.tz_convert("UTC")

        T_out_daily.index = idx

        common_days = int(T_out_daily.index.intersection(obs_macro.index).shape[0])

        # If too few common days, we can still return something, but the fit is unstable.
        # We don't raise here; caller can decide.

        candidates: List[CandidateScore] = []

        for tau in tau_grid:
            T_s = self._smooth_outdoor(T_out_daily, tau)

            for hon in heating_on_grid:
                hoff = float(hon + heating_hyst)
                for con in cooling_on_grid:
                    coff = float(con - cooling_hyst)

                    cfg = RegimeConfig(
                        tau_days=float(tau),
                        heating_on=float(hon),
                        heating_off=float(hoff),
                        cooling_on=float(con),
                        cooling_off=float(coff),
                    )

                    pred = self._predict_regime_from_outdoor(T_s, cfg)
                    acc, n = self._accuracy(pred, obs_macro)
                    if n == 0 or math.isnan(acc):
                        continue

                    err = 1.0 - acc
                    switches = self._count_switches(pred)
                    pen = switch_penalty_weight * (switches / max(1, n))
                    loss = err + pen

                    candidates.append(
                        CandidateScore(cfg=cfg, loss=float(loss), err=float(err), pen=float(pen), switches=int(switches), days=int(n))
                    )

        if not candidates:
            # Fallback: return a default config and empty scores
            fallback = CandidateScore(
                cfg=RegimeConfig(tau_days=5.0, heating_on=13.0, heating_off=14.0, cooling_on=24.0, cooling_off=23.0),
                loss=float("nan"),
                err=float("nan"),
                pen=0.0,
                switches=0,
                days=0,
            )
            return RegimeSearchResult(best=fallback, top10=[fallback], obs_counts=obs_regime_daily.value_counts(dropna=False), common_days=common_days)

        candidates.sort(key=lambda c: c.loss)
        top10 = candidates[: max(1, int(top_k))]
        best = top10[0]

        if self.debug:
            print("\nObserved regimes (plant-aware) counts:")
            print(obs_regime_daily.value_counts(dropna=False))
            print("Common non-null days (macro obs vs outdoor):", best.days)
            print("\nTop 10 configs:")
            for c in top10:
                print(
                    f"loss={c.loss:.3f} err={c.err:.3f} pen={c.pen:.3f} "
                    f"switches={c.switches}/{c.days} tau={c.cfg.tau_days:.1f} "
                    f"hon={c.cfg.heating_on:.1f} hoff={c.cfg.heating_off:.1f} "
                    f"con={c.cfg.cooling_on:.1f} coff={c.cfg.cooling_off:.1f}"
                )
            print("\nBest RegimeConfig:\ncfg = RegimeConfig(")
            print(
                f"    tau_days={best.cfg.tau_days:.1f},\n"
                f"    heating_on={best.cfg.heating_on:.1f}, heating_off={best.cfg.heating_off:.1f},\n"
                f"    cooling_on={best.cfg.cooling_on:.1f}, cooling_off={best.cfg.cooling_off:.1f},\n"
                f")"
            )

        return RegimeSearchResult(
            best=best,
            top10=top10,
            obs_counts=obs_regime_daily.value_counts(dropna=False),
            common_days=best.days,
        )

    # --------------------- orchestrator ---------------------

    def run(self) -> RegimeSearchResult:
        raw = self.load_raw()
        norm = self.normalize(raw)

        obs_daily, duty_daily, _frame = self.build_observed_daily_regime(norm)

        # Outdoor daily mean
        T_out_daily = norm["T_out"].resample("1D").mean()

        return self.grid_search_regime(T_out_daily=T_out_daily, obs_regime_daily=obs_daily)


# ----------------------------- convenience factory -----------------------------


def pipeline_from_env(
    *,
    start: str = "-730d",
    stop: str = "now()",
    debug: bool = True,
    power_threshold_w: float = 250.0,
    duty_min: float = 0.20,
    cool_vmc_duty_min: Optional[float] = None,
    entities: Optional[PlantEntities] = None,
) -> PlantRegimePipeline:
    """Create a pipeline from environment variables.

    Expected env vars:
      INFLUX_URL, INFLUX_ORG, INFLUX_TOKEN, INFLUX_BUCKET

    Entities can be passed explicitly; if omitted, we use your current defaults.
    """

    cfg = InfluxConfig(
        url = "http://127.0.0.1:8086", # os.environ["INFLUX_URL"]          # es: http://127.0.0.1:8086
        token = "lEjXciGoTt4E2G-KfFEIUVfSLDF4jzoZ-2_Ylr9jTvNq9p3kgnpHOfYOTdVtqi7L50A1XI8QuEa2APC0NmxeEg==", # os.environ["INFLUX_TOKEN"]
        org = "drp", # os.environ["INFLUX_ORG"]
        bucket = "drp", # os.environ["INFLUX_BUCKET"]
    )

    if entities is None:
        entities = PlantEntities(
            outdoor_temp="ambient_outdoor_temperature",
            compressor_state="hmi080_compressor_state",
            device_mode="hmi080_device_mode",
            vmc_pump_switch="hcs_direct_supply_unit",
            radiant_pump_switch="hcs_motorized_temperature_adjustable_supply_unit",
            active_power="emeter_clima_active_power",
        )

    reader = InfluxSeriesReader(cfg)
    return PlantRegimePipeline(
        reader=reader,
        entities=entities,
        start=start,
        stop=stop,
        debug=debug,
        power_threshold_w=power_threshold_w,
        duty_min=duty_min,
        cool_vmc_duty_min=cool_vmc_duty_min,
    )


def main() -> int:
    pipeline = pipeline_from_env(
        start="-730d",
        stop="now()",
        debug=True,
        power_threshold_w=250.0,
        duty_min=0.20,
        cool_vmc_duty_min=None,
    )

    try:
        raw = pipeline.load_raw()
        norm = pipeline.normalize(raw)
        obs_daily, duty_daily, _frame = pipeline.build_observed_daily_regime(norm)

        T_out_daily = norm["T_out"].resample("1D").mean()

        result = pipeline.grid_search_regime(
            T_out_daily=T_out_daily,
            obs_regime_daily=obs_daily,
        )

        print("\n=== SUMMARY ===")
        print("Observed regimes counts (plant-aware):")
        print(result.obs_counts)

        best = result.best
        print("\nBest config:")
        print(best.cfg)

        print("\nScore:")
        print(f"  loss={best.loss:.3f}  err={best.err:.3f}  pen={best.pen:.3f}")
        print(f"  switches={best.switches}/{best.days}  common_days={result.common_days}")

        print("\nTop 10:")
        for i, c in enumerate(result.top10, start=1):
            print(
                f"{i:02d}) loss={c.loss:.3f} err={c.err:.3f} pen={c.pen:.3f} "
                f"switches={c.switches}/{c.days} "
                f"tau={c.cfg.tau_days:.1f} "
                f"hon={c.cfg.heating_on:.1f} hoff={c.cfg.heating_off:.1f} "
                f"con={c.cfg.cooling_on:.1f} coff={c.cfg.cooling_off:.1f}"
            )

        duty_daily.to_csv("duty_daily.csv", index=True)
        obs_daily.to_csv("obs_daily.csv", index=True, header=["observed_regime"])
        print("\nSaved: duty_daily.csv, obs_daily.csv")

        return 0

    finally:
        pipeline.reader.close()


if __name__ == "__main__":
    raise SystemExit(main())
